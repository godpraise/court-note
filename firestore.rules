rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedCoachEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function isAllowedCoach() {
      return verifiedCoachEmail()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Access grants are managed only through the console or Admin SDK.
    match /admins/{email} {
      allow get: if verifiedCoachEmail() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }
    match /coaches/{coachUid}/{collectionName}/{documentId} {
      allow read, write: if isAllowedCoach()
        && request.auth.uid == coachUid
        && collectionName in ['venues', 'members', 'lessons', 'passes', 'journals', 'skills', 'progress'];
    }
    // Preserve the old shared test data without exposing it to clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
